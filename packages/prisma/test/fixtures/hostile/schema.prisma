// Schema hostil del spike (spike.md, bloque 1).
//
// No es un ejemplo bonito: es lo que rompe generadores.
//   - enum, optional, @db.Text, @db.Uuid, Decimal, BigInt, Json, Bytes
//   - @id autoincrement (Int) y @id uuid (String)
//   - @default, @updatedAt, @unique
//   - m2o, o2m, auto-relación con nombre explícito
//   - lista escalar (String[])
//
// El datasource es PostgreSQL porque SQLite no soporta enums. `prisma generate`
// no se conecta, así que la URL no necesita apuntar a nada real.

datasource db {
  provider = "postgresql"
  // Prisma 7 ya no acepta `url` en el schema: la conexión vive en
  // `prisma.config.ts` o en el constructor del cliente. Para `generate` no hace
  // falta ninguna, así que el fixture no la declara.
}

generator dashild {
  provider = "dashild-prisma-generator"
  output   = "../generated/dashild"
}

enum Role {
  ADMIN
  USER
}

model Organization {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  users User[]
}

model User {
  id     String  @id @default(uuid()) @db.Uuid
  email  String  @unique
  name   String?
  role   Role    @default(USER)
  balance Decimal @db.Decimal(12, 2)
  bigNumber BigInt
  metadata Json?
  avatar Bytes?
  bio    String? @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  published Boolean @default(false)
  tags      String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  parentId Int?
  parent   Post?  @relation("PostHierarchy", fields: [parentId], references: [id])
  children Post[] @relation("PostHierarchy")
}
