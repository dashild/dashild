{
  "name": "@dashild/cli",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "Dashild CLI: init, make:resource, doctor and ui:add",
  "license": "MIT",
  "bin": {
    "dashild": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/types": "^8.1.3",
    "@dashild/core": "workspace:*",
    "commander": "^15.1.0"
  },
  "author": "Daljomar Morillo",
  "keywords": [
    "dashild",
    "admin",
    "nextjs",
    "prisma",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashild/dashild.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dashild/dashild#readme",
  "bugs": {
    "url": "https://github.com/dashild/dashild/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
