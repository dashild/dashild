{
  "name": "@dashild/admin",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Dashild client runtime: shell, table, form, actions and shadcn primitives",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dashild/core": "workspace:*",
    "@hookform/resolvers": "^7.0.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "radix-ui": "^1.8.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "author": "Daljomar Morillo",
  "keywords": [
    "dashild",
    "admin",
    "nextjs",
    "react",
    "shadcn",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashild/dashild.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/dashild/dashild#readme",
  "bugs": {
    "url": "https://github.com/dashild/dashild/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
