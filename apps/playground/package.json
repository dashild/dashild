{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "App Next.js que simula una aplicación preexistente. No se publica.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:smoke": "tsx scripts/smoke.ts",
    "db:write-smoke": "tsx scripts/write-smoke.ts",
    "db:security-smoke": "tsx scripts/security-smoke.ts",
    "db:scope-smoke": "tsx scripts/scope-extension-smoke.ts",
    "db:bytes-smoke": "tsx scripts/bytes-smoke.ts",
    "db:m2m-smoke": "tsx scripts/m2m-smoke.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.27",
    "@dashild/admin": "workspace:*",
    "@dashild/core": "workspace:*",
    "@hookform/resolvers": "^7.0.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dashild/cli": "workspace:*",
    "@dashild/prisma": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
