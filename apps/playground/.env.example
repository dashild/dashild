# Conexión de la app de ejemplo (Postgres de lerd).
#
# Next corre en el host, así que usa 127.0.0.1 y el puerto publicado, no
# `lerd-postgres` (ese nombre solo resuelve dentro de la red de contenedores).
# Credenciales por defecto de lerd: postgres / lerd.
DATABASE_URL="postgresql://postgres:lerd@127.0.0.1:5432/playground"

# Better Auth. Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3100"
