---
import type { IconName } from "../../landing/copy";

interface Props {
  name: IconName | "github" | "check" | "x";
  size?: number;
  class?: string;
}

/**
 * Landing icons.
 *
 * Geometry comes from Lucide 1.82.0 (ISC, https://lucide.dev), inlined so the
 * static site keeps no icon dependency. The stroke width is tuned to 1.6 for
 * the landing instead of Lucide's default 2. The GitHub mark is the official
 * brand asset.
 */
const { name, size = 20, class: className } = Astro.props;
const isBrand = name === "github";
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? "currentColor" : "none"}
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "file" && (
      <>
        <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
        <path d="M14 2v5a1 1 0 0 0 1 1h5" />
      </>
    )
  }
  {
    name === "shield" && (
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    )
  }
  {
    name === "layers" && (
      <>
        <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
        <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
        <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
      </>
    )
  }
  {
    name === "code" && (
      <>
        <path d="m18 16 4-4-4-4" />
        <path d="m6 8-4 4 4 4" />
        <path d="m14.5 4-5 16" />
      </>
    )
  }
  {
    name === "database" && (
      <>
        <ellipse cx="12" cy="5" rx="9" ry="3" />
        <path d="M3 5V19A9 3 0 0 0 21 19V5" />
        <path d="M3 12A9 3 0 0 0 21 12" />
      </>
    )
  }
  {
    name === "terminal" && (
      <>
        <path d="M12 19h8" />
        <path d="m4 17 6-6-6-6" />
      </>
    )
  }
  {name === "check" && <path d="M20 6 9 17l-5-5" />}
  {name === "x" && <path d="M18 6 6 18" />}
  {name === "x" && <path d="m6 6 12 12" />}
  {
    name === "github" && (
      <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
    )
  }
</svg>
